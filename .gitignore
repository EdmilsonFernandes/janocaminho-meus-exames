# Dependências
node_modules/

# Builds
dist/
build/
*.tsbuildinfo

# Ambiente / segredos
.env
.env.local
.env.*.local

# Dados sensíveis (PDFs/fotos = PII sob LGPD; nunca commitar) — dirs de RUNTIME, NÃO o código em web/src/data
/data/
packages/server/data/
packages/data/
uploads/
samples/*.pdf
samples/*.jpg
samples/*.png

# Logs
*.log
npm-debug.log*

# SO / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Template AdminLTE (descartado — não faz parte do app)
AdminLTE/

# Android / Capacitor
packages/mobile/android/app/build/
packages/mobile/android/.gradle/
packages/mobile/android/local.properties
packages/mobile/android/captures/
packages/mobile/android/.idea/
packages/mobile/ios/App/App/Private/
android-build.log
.shot-*.png
# Web build output syncado pro mobile (gerado por `npm run sync` — artefato, NÃO fonte.
# Excluído do grafo graphify pra queries não voltarem ruído de .js minificados.)
packages/mobile/www/
packages/mobile/android/app/src/main/assets/public/

# Firebase (config do projeto — local; o server usa serviceAccountKey.json separado)
**/google-services.json
**/google-services.*.json
**/serviceAccountKey.json
**/*firebase-adminsdk*.json
packages/mobile/android/app/keystore.properties
*.keystore

# Análise de código (regenerável — graphify/serena geram localmente)
graphify-out/
**/graphify-out/
.serena/cache/
.serena/memories/


# build temp do workaround de dist travado
packages/web/dist2/

# Build info gerado (versão/commit — regenerado a cada build; não commitar)
packages/*/src/generated/
packages/web/public/build-info.json

# Playwright (E2E do web) — artefatos regeneráveis, não commitar
packages/web/playwright-report/
packages/web/test-results/
packages/web/e2e/screenshots/
packages/web/e2e/.auth/
packages/web/playwright/.cache/

# Skills de cibersegurança de terceiros (mukul975/Anthropic-Cybersecurity-Skills) — subconjunto
# defensivo (384 skills / 21MB). Dependência de dev (como node_modules), reinstalável; não commitar.
# Ver memory "cybersecurity-skills-instaladas".
.claude/skills/cybersecurity/

# Skills de terceiros via `npx skills` (pbakaus/impeccable etc.) — junction p/ .agents/skills/.
# Dev dep reinstalável (como node_modules); não commitar. Reinstalar:
#   npx skills add https://github.com/pbakaus/impeccable --skill impeccable
.agents/
.claude/skills/impeccable
