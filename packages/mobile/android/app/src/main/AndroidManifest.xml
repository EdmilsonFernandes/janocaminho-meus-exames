<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect exige minSdk 26; o app suporta 23 (Android 6/7 da base ainda ativa).
         Seguro porque TODO acesso às classes HC no HealthBridge é guardado por
         Build.VERSION.SDK_INT >= 26 — em aparelhos <26 o widget simplesmente não aparece. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <!-- @capgo/capacitor-social-login traz a permissão AD_ID via dependência do login do Facebook
         (que não usamos — só Google). Removida p/ a declaração "não usa ID de publicidade" do
         Play Console ficar consistente com o app (sem anúncios). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Health Connect (Activity Widget — leitura APENAS, nunca escrita): passos, calorias
         totais e distância. Declaração exigida p/ o popup nativo de permissão funcionar. -->
    <!-- Formato ANTIGO (Android 13- / app da Play Store com.google.android.apps.healthdata) -->
    <uses-permission android:name="androidx.health.connect.permission.read.Steps" />
    <uses-permission android:name="androidx.health.connect.permission.read.TotalCaloriesBurned" />
    <uses-permission android:name="androidx.health.connect.permission.read.Distance" />
    <!-- Formato NOVO (Android 14+ / módulo de SISTEMA com.google.android.healthconnect.controller)
         — sem estas, o sistema mostra "Atualização necessária" e NÃO deixa conceder permissões. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />

    <!-- ANDROID 11+ (API 30): VISIBILIDADE DE PACOTE — sem este bloco o intent da sheet de
         permissão do Health Connect resolve VAZIO em muitos aparelhos: a sheet simplesmente
         não abre e nenhum erro sobe (bug real do AAB 335/337: "clico e nada acontece"). -->
    <queries>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <!-- HC via Play (Android 13-) e HC de SISTEMA (Android 14+: o controller é quem
             expõe PermissionsActivity — sem este pacote no queries, o launch() falha
             SILENCIOSAMENTE em Samsung/Android 16. Bug real diagnosticado via ADB.) -->
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.google.android.healthconnect.controller" />
        <provider android:authorities="androidx.health-connect.provider" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Atalhos estáticos (long-press no ícone): Cartão de emergência -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

            <!-- Health Connect (Android ≤13): rationale das permissões (o link de política de
                 privacidade do Health Connect abre o app aqui — cai na rota /privacidade). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect (Android 14+): exigência do Play p/ apps que LEEM dados de saúde.
             Alias aponta pra MainActivity — a tela de permissões do sistema leva até aqui. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Política de privacidade exigida pelo Health Connect (tela de permissões do sistema). -->
        <meta-data
            android:name="health_connect.privacy_policy_url"
            android:value="https://janocaminho.com.br/minhasaude/#/privacidade" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Canal padrão de notificação — garante que push apareça na bandeja com app fechado -->
        <meta-data android:name="default_notification_channel_id" android:value="meus-exames" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="true" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Câmera: foto do exame -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Galeria/fotos: o app usa o SELETOR DE SISTEMA (<input type=file accept=image/*> → Photo Picker
         no Android 13+), que NÃO exige permissão de mídia. READ_MEDIA_IMAGES foi REMOVIDO por exigência
         da Política de permissões de acesso a fotos/vídeos do Google Play (apps Android 13+ devem usar
         o seletor de fotos, não permissão ampla). READ/WRITE_EXTERNAL_STORAGE permanecem limitados a
         Android <=12 / <=29 (maxSdkVersion) — apenas legado, fora do escopo da política (API 33+). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Push notifications (Android 13+ exige POST_NOTIFICATIONS) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- (Biometria — permissões a adicionar quando implementar o unlock biométrico)
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    -->
</manifest>
