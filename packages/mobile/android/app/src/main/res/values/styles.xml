<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Status bar na cor da marca (contínua com o splash) + ícones claros sobre teal -->
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 15+ (edge-to-edge + adjustMarginsForEdgeToEdge='auto'): as faixas de
             status/gesture bar ficam expostas mostrando o fundo da WINDOW. Sem isso o padrão
             é branco (claro) — ícones claros da status bar sumiriam. Teal = contínuo com o
             splash e o bg do WebView (paintWebViewBrandBg). Android ≤14: item invisível. -->
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/splash_bg</item>
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <!-- Logo no splash (Android 12+ recorta em máscara circular) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
    </style>

    <!-- Strings dos atalhos estáticos (evita hardcode no XML de shortcuts) -->
    <string name="shortcut_emergency">Cartão de emergência</string>
    <string name="shortcut_emergency_long">Abrir cartão de emergência</string>
</resources>