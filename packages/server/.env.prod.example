# KYC do médico (UaiID) — spec docs/design/2026-10-28-verificacao-medico-spec.md §8
UAIID_API_KEY=
UAIID_WEBHOOK_SECRET=
# UAIID_BASE_URL=https://api.uaiid.com.br
# Origem da TELA de validação (o UaiID devolve verify_url relativo "/verify/<token>"). Não é o host da API.
# UAIID_VERIFY_BASE_URL=https://uaiid.com.br
# UAIID_TIMEOUT_MS=8000
# UAIID_RETURN_URL=https://drexame.janocaminho.com.br/#/doctor?kyc=1
# Teto GLOBAL diário de sessões de verificação abertas no UaiID (TODAS as contas, janela de 24 h) — cada sessão é COBRADA.
# Atingido o teto, POST /api/doctor/verification responde 503 KYC_UNAVAILABLE e o dono recebe 1 e-mail a cada 6 h.
# KYC_DAILY_SESSION_CAP=100
